// One Worker serves both the library SPA (built by Vite) and the API under /api.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kumostamp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Every non-file path gets index.html, like the old Pages _redirects.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kumostamp",
      // Local dev works with this placeholder. Before deploying, run
      // `npx wrangler d1 create kumostamp` and paste the id it prints here.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
