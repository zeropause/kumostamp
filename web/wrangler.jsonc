// One Worker serves both the library SPA (built by Vite) and the API under /api.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kumostamp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Every non-file path gets index.html, like the old Pages _redirects.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kumostamp",
      "database_id": "60487194-af3f-4f90-a15e-d28b1a0516d2",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
