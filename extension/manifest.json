{
  "manifest_version": 3,
  "key": "",
  "name": "Kumostamp",
  "short_name": "Kumostamp",
  "version": "0.1.0",
  "description": "Remembers the minute you stopped in an anime or series, and carries it to whichever site you watch on next.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Kumostamp",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": [
        "lib/core.js",
        "detect.js",
        "content.js"
      ]
    },
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "js": [
        "main-world.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "js": [
        "bridge.js"
      ]
    }
  ]
}